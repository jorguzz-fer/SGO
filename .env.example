# ===== Banco (Postgres do Coolify) =====
DATABASE_URL="postgresql://sgo:senha@postgres:5432/sgo?schema=public"

# ===== Auth (NextAuth v5) =====
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Em produção, a URL pública do app:
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== Storage (S3-compatível: MinIO ou Cloudflare R2) =====
# Opção A — MinIO (self-hosted no Coolify):
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
# Opção B — Cloudflare R2 (descomente e use estes):
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
S3_BUCKET="sgo-asos"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ===== Seed do admin inicial (opcional) =====
SEED_ADMIN_EMAIL="admin@wowmais.com.br"
SEED_ADMIN_SENHA=""

# ===== Integração Wow+ (a configurar contra o repo wowmais) =====
WOWMAIS_API_URL=""
WOWMAIS_WEBHOOK_URL=""
WOWMAIS_WEBHOOK_SECRET=""
